  <materials>
    <element name="Hydrogen" formula="H" Z="1"><atom value="1.008"/></element>
    <element name="Carbon" formula="C" Z="6"><atom value="12.011"/></element>
    <element name="Nitrogen" formula="N" Z="7"><atom value="14.007"/></element>
    <element name="Oxygen" formula="O" Z="8"><atom value="15.999"/></element>
    <!-- LAB + 2 g/L PPO: LAB ~ C18H30 (dodecylbenzene), density 0.86 g/cm3 [arXiv:2104.11687] -->
    <material name="LABPPO" state="liquid">
      <property name="RINDEX" ref="LS_RINDEX"/>
      <property name="ABSLENGTH" ref="LS_ABSLENGTH"/>
      <property name="RAYLEIGH" ref="LS_RAYLEIGH"/>
      <property name="REEMISSIONPROB" ref="LS_REEMISSIONPROB"/>   <!-- Opticks re-emission -->
      <!-- legacy names: Opticks U4Scint needs FASTCOMPONENT + SLOWCOMPONENT (identical) + REEMISSIONPROB -->
      <property name="FASTCOMPONENT" ref="LS_EMISSION"/>
      <property name="SLOWCOMPONENT" ref="LS_EMISSION"/>
      <property name="FASTTIMECONSTANT" ref="LS_TAU1"/>
      <property name="SLOWTIMECONSTANT" ref="LS_TAU3"/>
      <property name="YIELDRATIO" ref="LS_FASTSLOWRATIO"/>
      <!-- Geant4 >= 11 names (used by OpticalSims G4ScintillationOpticks) -->
      <property name="SCINTILLATIONCOMPONENT1" ref="LS_EMISSION"/>
      <property name="SCINTILLATIONCOMPONENT2" ref="LS_EMISSION"/>
      <property name="SCINTILLATIONCOMPONENT3" ref="LS_EMISSION"/>
      <property name="SCINTILLATIONYIELD" ref="LS_LIGHTYIELD"/>
      <property name="RESOLUTIONSCALE" ref="LS_RESOLUTIONSCALE"/>
      <property name="SCINTILLATIONTIMECONSTANT1" ref="LS_TAU1"/>
      <property name="SCINTILLATIONTIMECONSTANT2" ref="LS_TAU2"/>
      <property name="SCINTILLATIONTIMECONSTANT3" ref="LS_TAU3"/>
      <property name="SCINTILLATIONYIELD1" ref="LS_YIELD1"/>
      <property name="SCINTILLATIONYIELD2" ref="LS_YIELD2"/>
      <property name="SCINTILLATIONYIELD3" ref="LS_YIELD3"/>
      <property name="SCINTILLATIONRISETIME1" ref="LS_RISE"/>
      <property name="SCINTILLATIONRISETIME2" ref="LS_RISE"/>
      <property name="SCINTILLATIONRISETIME3" ref="LS_RISE"/>
      <property name="BIRKSCONSTANT" ref="LS_BIRKS"/>   <!-- informational: Geant4 takes Birks from G4IonisParamMat -->
      <D unit="g/cm3" value="0.86"/>
      <composite n="18" ref="Carbon"/>
      <composite n="30" ref="Hydrogen"/>
    </material>
    <material name="Acrylic" state="solid">
      <property name="RINDEX" ref="ACRYLIC_RINDEX"/>
      <property name="ABSLENGTH" ref="ACRYLIC_ABSLENGTH"/>
      <D unit="g/cm3" value="1.18"/>
      <composite n="5" ref="Carbon"/>
      <composite n="8" ref="Hydrogen"/>
      <composite n="2" ref="Oxygen"/>
    </material>
    <material name="Water" state="liquid">
      <property name="RINDEX" ref="WATER_RINDEX"/>
      <property name="ABSLENGTH" ref="WATER_ABSLENGTH"/>
      <property name="RAYLEIGH" ref="WATER_RAYLEIGH"/>
      <D unit="g/cm3" value="1.0"/>
      <fraction n="1.0" ref="G4_WATER"/>
    </material>
    <material name="NitrogenGas" state="gas">
      <property name="RINDEX" ref="N2_RINDEX"/>
      <property name="ABSLENGTH" ref="N2_ABSLENGTH"/>
      <D unit="g/cm3" value="0.00125"/>
      <fraction n="1.0" ref="Nitrogen"/>
    </material>
  </materials>
