###################################################
# Batch running of events  
###################################################

# verbosity
/tracking/verbose 0
/control/verbose 0
/run/verbose 0
/run/numberOfThreads 1
/run/initialize

/RunAction/output/file out.root

# GPS Particle Generation
/gps/particle e-
/gps/energy 0.5 GeV
/gps/direction 0 0 -1
/gps/position 0 0 130

/run/beamOn 3